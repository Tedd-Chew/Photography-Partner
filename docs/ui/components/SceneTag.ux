<!--
  场景标签 — 小 badge 样式
  占位符: {sceneName} = 场景名（夜景人像/风景/美食…）
  占位符: {color} = 标签色，默认 ff9800
-->
<template>
  <div class="scene-tag">
    <text class="scene-dot">●</text>
    <text class="scene-name">夜景人像</text>
  </div>
</template>

<style>
  .scene-tag {
    flex-direction: row;
    align-items: center;
    padding: 4px 12px;
    border-radius: 12px;
    background-color: rgba(255, 152, 0, 0.15);
    border: 1px solid rgba(255, 152, 0, 0.3);
  }

  .scene-dot {
    font-size: 10px;
    color: #ff9800;
    margin-right: 5px;
  }

  .scene-name {
    font-size: 13px;
    color: #ff9800;
    font-weight: bold;
  }
</style>
