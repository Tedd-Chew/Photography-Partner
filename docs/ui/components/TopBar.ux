<!--
  顶部导航栏
  占位符: {title} 替换为页面标题
  占位符: {titleBarBackgroundColor} = #1a1a2e
-->
<template>
  <div class="top-bar">
    <div class="back-btn">
      <text>← 返回</text>
    </div>
    <text class="title">页面标题</text>
    <div class="spacer"></div>
  </div>
</template>

<style>
  .top-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    background-color: #1a1a2e;
  }

  .back-btn text {
    font-size: 15px;
    color: #ffd700;
  }

  .title {
    font-size: 18px;
    font-weight: bold;
    color: #ffffff;
  }

  .spacer {
    width: 60px;
  }
</style>
