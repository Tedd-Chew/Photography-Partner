<import name="top-bar" src="../Common/TopBar.ux"></import>
<import name="photo-card" src="../Common/PhotoCard.ux"></import>
<import name="g-icon" src="../apex-ui/components/icon/index"></import>
<import name="bottom-nav" src="../Common/BottomNav.ux"></import>

<template>
  <div class="page">
    <top-bar title="历史记录"></top-bar>

    <list class="content">
      <list-item if="{{!items.length}}" type="gallery-empty">
        <div class="empty-state">
          <g-icon type="images" size="48" color="#86909C"></g-icon>
          <text class="empty-text">还没有分析记录</text>
          <text class="empty-hint">去选图页面开始第一次分析吧</text>
        </div>
      </list-item>

      <list-item if="{{items.length}}" type="gallery-list">
        <div class="gallery-list">
          <photo-card
            for="item in items"
            item="{{item}}"
            @click="onCardClick(item)">
          </photo-card>
        </div>
      </list-item>
    </list>

    <bottom-nav></bottom-nav>
  </div>
</template>

<script>
import router from '@system.router'
import { store } from '../store/index'
import { getGallery } from '../services/api'

export default {
  data: {
    items: [],
    page: 1,
    total: 0
  },

  onInit: function () {
    this.loadGallery()
  },

  loadGallery: function () {
    var self = this
    var uid = store.state.user.uid
    console.log('[Gallery] loadGallery uid=' + uid)
    if (!uid) {
      console.log('[Gallery] no uid, skip')
      return
    }
    getGallery(uid, self.page, 20).then(function (data) {
      var items = data.items || []
      // 解析 result_json 字符串
      for (var i = 0; i < items.length; i++) {
        if (typeof items[i].result_json === 'string') {
          try {
            items[i].result_json = JSON.parse(items[i].result_json)
          } catch (e) {}
        }
      }
      self.items = items
      self.total = data.total || 0
      store.setHistory(self.items)
    }).catch(function (e) {
      console.log('加载历史失败:', e)
    })
  },

  onCardClick: function (item) {
    store.state.analysis = item
    router.push({ uri: '/Result' })
  },

  onShow: function () {
    this.loadGallery()
  }
}
</script>

<style>
  .page {
    flex-direction: column;
    flex: 1;
    background-color: #EDF2F8;
    overflow: hidden;
  }

  .content {
    flex: 1;
    height: 0;
  }

  .gallery-list {
    flex-direction: column;
    padding: 0 16px;
  }

  .empty-state {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
  }

  .empty-text {
    font-size: 28px;
    color: #86909C;
    margin-bottom: 4px;
  }

  .empty-hint {
    font-size: 24px;
    color: #4E5969;
  }
</style>
