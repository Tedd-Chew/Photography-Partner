<import name="top-bar" src="../Common/TopBar.ux"></import>
<import name="photo-card" src="../Common/PhotoCard.ux"></import>
<import name="g-icon" src="../apex-ui/components/icon/index"></import>
<import name="bottom-nav" src="../Common/BottomNav.ux"></import>

<template>
  <div class="page">
    <top-bar title="历史记录"></top-bar>

    <list class="content">
      <list-item if="{{!items.length}}" type="gallery-empty">
        <div class="empty-state">
          <g-icon type="images" size="48" color="#86909C"></g-icon>
          <text class="empty-text">还没有分析记录</text>
          <text class="empty-hint">去选图页面开始第一次分析吧</text>
        </div>
      </list-item>

      <list-item if="{{items.length}}" type="gallery-list">
        <div class="gallery-list">
          <photo-card
            for="item in items"
            item="{{item}}"
            @click="onCardClick">
          </photo-card>
        </div>
      </list-item>
    </list>

    <bottom-nav></bottom-nav>
  </div>
</template>

<script>
import { store } from '../store/index'
import { getGallery, getGalleryDetail } from '../services/api'

export default {
  data: {
    items: [],
    page: 1,
    total: 0
  },

  async onInit() {
    await this.loadGallery()
  },

  async loadGallery() {
    const uid = store.state.user.uid
    if (!uid) return
    try {
      const data = await getGallery(uid, this.page, 20)
      this.items = data.items || []
      this.total = data.total || 0
      store.setHistory(this.items)
    } catch (e) {}
  },

  onCardClick(item) {
    this.$app.navigateTo('Result')
  }
}
</script>

<style>
  .page {
    flex-direction: column;
    flex: 1;
    background-color: #EDF2F8;
    overflow: hidden;
  }

  .content {
    flex: 1;
    height: 0;
  }

  .gallery-list {
    flex-direction: column;
    padding: 0 16px;
  }

  .empty-state {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
  }

  .empty-text {
    font-size: 28px;
    color: #86909C;
    margin-bottom: 4px;
  }

  .empty-hint {
    font-size: 24px;
    color: #4E5969;
  }
</style>
