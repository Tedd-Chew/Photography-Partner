<import name="top-bar" src="../Common/TopBar.ux"></import>
<import name="level-badge" src="../Common/LevelBadge.ux"></import>
<import name="badge-tag" src="../Common/BadgeTag.ux"></import>
<import name="stats-panel" src="../Common/StatsPanel.ux"></import>
<import name="bottom-nav" src="../Common/BottomNav.ux"></import>

<template>
  <div class="page">
    <top-bar title="我的成长"></top-bar>

    <scroll class="content">

      <level-badge
        level="{{user.level}}"
        exp="{{user.exp}}"
        exp-to-next="{{expToNext}}"
        level-name="{{levelName}}">
      </level-badge>

      <text class="section-label">🏅 勋章 ({{user.badges.length}}/3)</text>

      <div if="{{user.badges.length}}" class="badge-list">
        <badge-tag for="b in user.badges" name="{{b}}"></badge-tag>
      </div>

      <div if="{{!user.badges.length}}" class="empty-badges">
        <text class="empty-hint">还没有获得勋章，快去分析照片吧</text>
      </div>

      <stats-panel rows="{{statsRows}}"></stats-panel>
    </scroll>

    <bottom-nav tabs="{{navTabs}}"></bottom-nav>
  </div>
</template>

<script>
import { store } from '../store/index'
import { getUserInfo } from '../services/api'

const LEVELS = [
  { level: 1, name: '摄影新手', exp: 0 },
  { level: 2, name: '摄影学徒', exp: 100 },
  { level: 3, name: '摄影达人', exp: 300 },
  { level: 4, name: '摄影专家', exp: 600 },
  { level: 5, name: '摄影大师', exp: 1000 },
  { level: 6, name: '光影艺术家', exp: 1600 }
]

export default {
  data: {
    user: store.state.user,
    navTabs: [
      { icon: '📋', label: '历史' },
      { icon: '🖼️', label: '选图' },
      { icon: '🌟', label: '成长' }
    ]
  },

  computed: {
    levelName() {
      const lv = LEVELS.find(l => l.level === this.user.level)
      return lv ? lv.name : '摄影新手'
    },

    expToNext() {
      const lv = LEVELS.find(l => l.level === this.user.level + 1)
      return lv ? lv.exp : this.user.exp
    },

    statsRows() {
      const u = this.user
      return [
        [
          { value: u.totalAnalyses || 0, label: '累计分析' },
          { value: '--', label: '平均分' },
          { value: (u.badges || []).length, label: '获得勋章' }
        ],
        [
          { value: '--', label: '最高分' },
          { value: u.exp || 0, label: '总经验' },
          { value: '--', label: '连续打卡' }
        ]
      ]
    }
  },

  onShow() {
    this.user = store.state.user
  }
}
</script>

<style>
  .page {
    flex-direction: column;
    flex: 1;
    background-color: #0f0f23;
  }

  .content {
    flex: 1;
    flex-direction: column;
  }

  .section-label {
    font-size: 16px;
    font-weight: bold;
    color: #cccccc;
    padding: 16px 20px 10px;
  }

  .badge-list {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 0 20px 16px;
  }

  .empty-badges {
    padding: 8px 20px 16px;
  }

  .empty-hint {
    font-size: 13px;
    color: #555555;
  }
</style>
