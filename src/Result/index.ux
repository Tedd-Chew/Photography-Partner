<import name="top-bar" src="../Common/TopBar.ux"></import>
<import name="score-circle" src="../Common/ScoreCircle.ux"></import>
<import name="score-radar" src="../Common/ScoreRadar.ux"></import>
<import name="advice-card" src="../Common/AdviceCard.ux"></import>
<import name="issue-card" src="../Common/IssueCard.ux"></import>
<import name="bullet-list" src="../Common/BulletList.ux"></import>
<import name="param-panel" src="../Common/ParamPanel.ux"></import>
<import name="exp-gain-card" src="../Common/ExpGainCard.ux"></import>
<import name="level-up-card" src="../Common/LevelUpCard.ux"></import>
<import name="badge-unlock-card" src="../Common/BadgeUnlockCard.ux"></import>
<import name="res-icon" src="../apex-ui/components/icon/index"></import>
<import name="bottom-nav" src="../Common/BottomNav.ux"></import>

<template>
  <div class="page">
    <top-bar title="分析结果"></top-bar>

    <list class="content">
      <list-item class="content-wrap" type="result-main">

        <div if="{{mode === 'score'}}" class="outer-card score-outer">
          <score-circle score="{{scoreVal}}"></score-circle>
        </div>

        <div if="{{mode === 'score' && hasScores}}" class="outer-card">
          <score-radar scores="{{analysis.scores}}"></score-radar>
        </div>

        <div if="{{mode === 'edit'}}" class="outer-card">
          <advice-card comment="{{analysis.advice}}"></advice-card>
        </div>

        <div if="{{mode === 'score'}}" class="outer-card">
          <advice-card comment="{{analysis.comment}}"></advice-card>
        </div>

        <div if="{{mode === 'shooting' && hasParams}}" class="outer-card">
          <param-panel params="{{analysis.camera_params}}" scene="{{analysis.scene}}"></param-panel>
        </div>

        <div if="{{analysis.composition_tips && analysis.composition_tips.length}}" class="outer-card">
          <bullet-list iconType="options" title="构图建议" items="{{analysis.composition_tips}}"></bullet-list>
        </div>

        <div if="{{analysis.issues && analysis.issues.length}}" class="outer-card issues-outer">
          <text class="section-heading">问题诊断</text>
          <div for="issue in analysis.issues" class="issue-wrap">
            <issue-card item="{{issue}}"></issue-card>
          </div>
        </div>

        <div if="{{analysis.lighting_advice && mode === 'shooting'}}" class="outer-card">
          <div class="section-row">
            <res-icon type="flashlight" size="16" color="#C4A54A"></res-icon>
            <text class="section-label">用光建议</text>
          </div>
          <text class="section-text">{{analysis.lighting_advice}}</text>
        </div>

        <div if="{{analysis.extra_tips && mode === 'shooting'}}" class="outer-card">
          <div class="section-row">
            <res-icon type="paper-plane" size="16" color="#C4A54A"></res-icon>
            <text class="section-label">额外建议</text>
          </div>
          <text class="section-text">{{analysis.extra_tips}}</text>
        </div>

        <exp-gain-card if="{{analysis.exp_gained}}" exp="{{analysis.exp_gained}}"></exp-gain-card>

        <level-up-card
          if="{{levelUp}}"
          old-name="{{oldLevelName}}"
          new-name="{{newLevelName}}">
        </level-up-card>

        <badge-unlock-card
          if="{{analysis.badge_unlocked && analysis.badge_unlocked.length}}"
          name="{{analysis.badge_unlocked[0]}}">
        </badge-unlock-card>

      </list-item>
    </list>

    <bottom-nav></bottom-nav>
  </div>
</template>

<script>
import { store } from '../store/index'

const LEVEL_NAMES = ['', '摄影新手', '摄影学徒', '摄影达人', '摄影专家', '摄影大师', '光影艺术家']

export default {
  data: {
    mode: 'score',
    analysis: {},
    scoreVal: 0,
    hasScores: false,
    hasParams: false
  },

  computed: {
    levelUp() {
      var lu = this.analysis.level_up
      return lu && lu.level_up
    },
    oldLevelName() {
      var lu = this.analysis.level_up
      return lu ? (LEVEL_NAMES[lu.old_level] || '') : ''
    },
    newLevelName() {
      var lu = this.analysis.level_up
      return lu ? (LEVEL_NAMES[lu.new_level] || '') : ''
    }
  },

  onInit() {
    if (store.state.analysis) {
      this.analysis = store.state.analysis || {}
      this.mode = this.analysis.mode || 'score'
      this.scoreVal = this.analysis.score || 0
      this.hasScores = !!this.analysis.scores
      this.hasParams = !!this.analysis.camera_params
    }
  }
}
</script>

<style>
  .page {
    flex-direction: column;
    flex: 1;
    background-color: #EDF2F8;
    overflow: hidden;
  }

  .content {
    flex: 1;
    height: 0;
  }

  .content-wrap {
    flex-direction: column;
  }

  .outer-card {
    flex-direction: column;
    margin: 0 16px 10px 16px;
    padding: 24px 4px;
    border-radius: 18px;
    background-color: #F4F8FC;
    box-shadow: 0 4px 24px rgba(0,0,0,0.05);
  }

  .score-outer {
    padding: 10px 4px;
  }

  .issues-outer {
    padding: 24px 4px;
  }

  .section-heading {
    font-size: 28px;
    font-weight: bold;
    color: #595040;
    margin-left: 20px;
    margin-bottom: 12px;
  }

  .section-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    padding: 0 20px;
  }

  .section-label {
    font-size: 28px;
    color: #595040;
    font-weight: bold;
    margin-left: 6px;
  }

  .section-text {
    font-size: 28px;
    color: #4E5969;
    line-height: 40px;
    padding: 0 20px;
  }

  .issue-wrap {
    margin: 0 12px 10px 12px;
  }
</style>
