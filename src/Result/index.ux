<import name="top-bar" src="../Common/TopBar.ux"></import>
<import name="score-circle" src="../Common/ScoreCircle.ux"></import>
<import name="score-radar" src="../Common/ScoreRadar.ux"></import>
<import name="advice-card" src="../Common/AdviceCard.ux"></import>
<import name="issue-card" src="../Common/IssueCard.ux"></import>
<import name="bullet-list" src="../Common/BulletList.ux"></import>
<import name="param-panel" src="../Common/ParamPanel.ux"></import>
<import name="exp-gain-card" src="../Common/ExpGainCard.ux"></import>
<import name="level-up-card" src="../Common/LevelUpCard.ux"></import>
<import name="badge-unlock-card" src="../Common/BadgeUnlockCard.ux"></import>
<import name="res-icon" src="../apex-ui/components/icon/index"></import>
<import name="bottom-nav" src="../Common/BottomNav.ux"></import>

<template>
  <div class="page">
    <top-bar title="分析结果"></top-bar>

    <list class="content">

      <list-item if="{{thumbUrl}}" type="result-photo">
        <div class="outer-card photo-outer">
          <image class="result-photo" src="{{thumbUrl}}"></image>
        </div>
      </list-item>

      <list-item if="{{mode === 'score'}}" type="result-score">
        <div class="outer-card score-outer">
          <score-circle score="{{scoreVal}}"></score-circle>
        </div>
      </list-item>

      <list-item if="{{mode === 'score' && hasScores}}" type="result-radar">
        <div class="outer-card">
          <score-radar scores="{{analysis.scores}}"></score-radar>
        </div>
      </list-item>

      <list-item if="{{mode === 'edit'}}" type="result-advice-edit">
        <div class="outer-card">
          <advice-card comment="{{analysis.advice}}"></advice-card>
        </div>
      </list-item>

      <list-item if="{{mode === 'score'}}" type="result-advice-score">
        <div class="outer-card">
          <advice-card comment="{{analysis.comment}}"></advice-card>
        </div>
      </list-item>

      <list-item if="{{mode === 'shooting' && hasParams}}" type="result-params">
        <div class="outer-card">
          <param-panel params="{{analysis.camera_params}}" scene="{{analysis.scene}}"></param-panel>
        </div>
      </list-item>

      <list-item if="{{analysis.composition_tips && analysis.composition_tips.length}}" type="result-tips">
        <div class="outer-card">
          <bullet-list iconType="options" title="构图建议" items="{{analysis.composition_tips}}"></bullet-list>
        </div>
      </list-item>

      <list-item if="{{analysis.issues && analysis.issues.length}}" type="result-issues">
        <div class="outer-card issues-outer">
          <text class="section-heading">问题诊断</text>
          <div for="issue in analysis.issues" class="issue-wrap">
            <issue-card item="{{issue}}"></issue-card>
          </div>
        </div>
      </list-item>

      <list-item if="{{analysis.lighting_advice && mode === 'shooting'}}" type="result-lighting">
        <div class="outer-card">
          <div class="section-row">
            <res-icon type="flashlight" size="16" color="#C4A54A"></res-icon>
            <text class="section-label">用光建议</text>
          </div>
          <text class="section-text">{{analysis.lighting_advice}}</text>
        </div>
      </list-item>

      <list-item if="{{analysis.extra_tips && mode === 'shooting'}}" type="result-extra">
        <div class="outer-card">
          <div class="section-row">
            <res-icon type="paper-plane" size="16" color="#C4A54A"></res-icon>
            <text class="section-label">额外建议</text>
          </div>
          <text class="section-text">{{analysis.extra_tips}}</text>
        </div>
      </list-item>

      <list-item if="{{analysis.exp_gained}}" type="result-exp">
        <exp-gain-card exp="{{analysis.exp_gained}}"></exp-gain-card>
      </list-item>

      <list-item if="{{levelUp}}" type="result-levelup">
        <level-up-card old-name="{{oldLevelName}}" new-name="{{newLevelName}}"></level-up-card>
      </list-item>

      <list-item if="{{analysis.badge_unlocked && analysis.badge_unlocked.length}}" type="result-badge">
        <badge-unlock-card name="{{analysis.badge_unlocked[0]}}"></badge-unlock-card>
      </list-item>

    </list>

    <bottom-nav></bottom-nav>
  </div>
</template>

<script>
import { store } from '../store/index'
import { getCache } from '../helper/storage'

const LEVEL_NAMES = ['', '摄影新手', '摄影学徒', '摄影达人', '摄影专家', '摄影大师', '光影艺术家']

export default {
  data: {
    mode: 'score',
    analysis: {},
    scoreVal: 0,
    thumbUrl: '',
    hasScores: false,
    hasParams: false
  },

  computed: {
    levelUp() {
      var lu = this.analysis.level_up
      return lu && lu.level_up
    },
    oldLevelName() {
      var lu = this.analysis.level_up
      return lu ? (LEVEL_NAMES[lu.old_level] || '') : ''
    },
    newLevelName() {
      var lu = this.analysis.level_up
      return lu ? (LEVEL_NAMES[lu.new_level] || '') : ''
    }
  },

  onInit: function () {
    var data = store.state.analysis
    if (data && data.mode) {
      this.loadData(data)
      return
    }
    var self = this
    getCache('analysis').then(function (cached) {
      if (cached && cached.mode) { self.loadData(cached) }
    })
  },

  loadData: function (data) {
    console.log('[Result] loadData mode=' + (data && data.mode) + ' score=' + (data && data.score) + ' scene=' + (data && data.scene))
    this.analysis = data || {}
    this.mode = this.analysis.mode || 'score'
    this.scoreVal = this.analysis.score || 0
    this.hasScores = !!this.analysis.scores
    this.hasParams = !!this.analysis.camera_params
    var tu = this.analysis.thumb_url || ''
    if (tu && tu.indexOf('/') === 0) { tu = 'http://192.168.137.1:8000' + tu }
    this.thumbUrl = tu
  }
}
</script>

<style>
  .page {
    flex-direction: column;
    flex: 1;
    background-color: #EDF2F8;
    overflow: hidden;
  }

  .content {
    flex: 1;
    height: 0;
  }

  .outer-card {
    flex-direction: column;
    margin: 0 16px 10px 16px;
    padding: 24px 4px;
    border-radius: 18px;
    background-color: #F4F8FC;
    box-shadow: 0 4px 24px rgba(0,0,0,0.05);
  }

  .score-outer {
    padding: 10px 4px;
  }

  .issues-outer {
    padding: 24px 4px;
  }

  .section-heading {
    font-size: 28px;
    font-weight: bold;
    color: #595040;
    margin-left: 20px;
    margin-bottom: 12px;
  }

  .section-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    padding: 0 20px;
  }

  .section-label {
    font-size: 28px;
    color: #595040;
    font-weight: bold;
    margin-left: 6px;
  }

  .section-text {
    font-size: 28px;
    color: #4E5969;
    line-height: 40px;
    padding: 0 20px;
  }

  .issue-wrap {
    margin: 0 12px 10px 12px;
  }

  .photo-outer {
    align-items: center;
    padding: 12px 4px;
  }

  .result-photo {
    width: 300px;
    height: 300px;
    border-radius: 12px;
  }
</style>
