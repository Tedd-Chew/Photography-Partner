<import name="top-bar" src="../Common/TopBar.ux"></import>
<import name="score-circle" src="../Common/ScoreCircle.ux"></import>
<import name="score-radar" src="../Common/ScoreRadar.ux"></import>
<import name="advice-card" src="../Common/AdviceCard.ux"></import>
<import name="issue-card" src="../Common/IssueCard.ux"></import>
<import name="bullet-list" src="../Common/BulletList.ux"></import>
<import name="param-panel" src="../Common/ParamPanel.ux"></import>
<import name="exp-gain-card" src="../Common/ExpGainCard.ux"></import>
<import name="level-up-card" src="../Common/LevelUpCard.ux"></import>
<import name="badge-unlock-card" src="../Common/BadgeUnlockCard.ux"></import>
<import name="bottom-nav" src="../Common/BottomNav.ux"></import>

<template>
  <div class="page">
    <top-bar title="分析结果"></top-bar>

    <div class="content">

      <score-circle if="{{mode === 'score'}}" score="{{scoreVal}}"></score-circle>

      <score-radar if="{{mode === 'score' && hasScores}}" scores="{{analysis.scores}}"></score-radar>

      <advice-card if="{{mode === 'edit'}}" comment="{{analysis.advice}}"></advice-card>

      <advice-card if="{{mode === 'score'}}" comment="{{analysis.comment}}"></advice-card>

      <param-panel if="{{mode === 'shooting' && hasParams}}" params="{{analysis.camera_params}}" scene="{{analysis.scene}}"></param-panel>

      <bullet-list
        if="{{analysis.composition_tips && analysis.composition_tips.length}}"
        icon="📐"
        title="构图建议"
        items="{{analysis.composition_tips}}">
      </bullet-list>

      <div for="issue in analysis.issues" if="{{analysis.issues}}">
        <issue-card item="{{issue}}"></issue-card>
      </div>

      <div if="{{analysis.lighting_advice && mode === 'shooting'}}" class="lighting-section">
        <text class="lighting-label">💡 用光建议</text>
        <text class="lighting-text">{{analysis.lighting_advice}}</text>
      </div>

      <div if="{{analysis.extra_tips && mode === 'shooting'}}" class="extra-section">
        <text class="lighting-label">📝 额外建议</text>
        <text class="lighting-text">{{analysis.extra_tips}}</text>
      </div>

      <exp-gain-card if="{{analysis.exp_gained}}" exp="{{analysis.exp_gained}}"></exp-gain-card>

      <level-up-card
        if="{{levelUp}}"
        old-name="{{oldLevelName}}"
        new-name="{{newLevelName}}">
      </level-up-card>

      <badge-unlock-card
        if="{{analysis.badge_unlocked && analysis.badge_unlocked.length}}"
        name="{{analysis.badge_unlocked[0]}}">
      </badge-unlock-card>

    </div>

    <bottom-nav tabs="{{navTabs}}"></bottom-nav>
  </div>
</template>

<script>
import { store } from '../store/index'

const LEVEL_NAMES = ['', '摄影新手', '摄影学徒', '摄影达人', '摄影专家', '摄影大师', '光影艺术家']

export default {
  data: {
    mode: 'score',
    analysis: {},
    scoreVal: 0,
    hasScores: false,
    hasParams: false,
    navTabs: [
      { icon: '📋', label: '历史' },
      { icon: '🖼️', label: '选图' },
      { icon: '🌟', label: '成长' }
    ]
  },

  computed: {
    levelUp() {
      var lu = this.analysis.level_up
      return lu && lu.level_up
    },
    oldLevelName() {
      var lu = this.analysis.level_up
      return lu ? (LEVEL_NAMES[lu.old_level] || '') : ''
    },
    newLevelName() {
      var lu = this.analysis.level_up
      return lu ? (LEVEL_NAMES[lu.new_level] || '') : ''
    }
  },

  onInit() {
    if (store.state.analysis) {
      this.analysis = store.state.analysis || {}
      this.mode = this.analysis.mode || 'score'
      this.scoreVal = this.analysis.score || 0
      this.hasScores = !!this.analysis.scores
      this.hasParams = !!this.analysis.camera_params
    }
  }
}
</script>

<style>
  .page {
    flex-direction: column;
    flex: 1;
    background-color: #0f0f23;
  }

  .content {
    flex: 1;
    flex-direction: column;
  }

  .lighting-section {
    background-color: #1a1a2e;
    border-radius: 12px;
    padding: 16px;
    margin: 8px 20px;
  }

  .lighting-label {
    font-size: 16px;
    color: #cccccc;
    font-weight: bold;
    margin-bottom: 8px;
  }

  .lighting-text {
    font-size: 14px;
    color: #cccccc;
    line-height: 22px;
  }

  .extra-section {
    background-color: #1a1a2e;
    border-radius: 12px;
    padding: 16px;
    margin: 8px 20px;
  }
</style>
