<import name="camera-box" src="../Common/CameraBox.ux"></import>
<import name="scene-tag" src="../Common/SceneTag.ux"></import>
<import name="grid-control" src="../Common/GridControl.ux"></import>
<import name="shoot-button" src="../Common/ShootButton.ux"></import>
<import name="param-panel" src="../Common/ParamPanel.ux"></import>
<import name="loading-overlay" src="../Common/LoadingOverlay.ux"></import>
<import name="bottom-nav" src="../Common/BottomNav.ux"></import>

<template>
  <div class="page">
    <div class="back-fixed" onclick="onBack">
      <text>← 返回</text>
    </div>

    <list class="content">
      <list-item class="content-wrap" type="camera-main">

        <div if="{{compositionTips.length || lightingAdvice || extraTips}}" class="outer-card">
          <div if="{{compositionTips && compositionTips.length}}" class="mid-card">
            <text class="mid-card-title">构  图</text>
            <text class="mid-card-desc" if="{{!compositionTips.length}}">暂无建议</text>
            <div class="tip-item" for="tip in compositionTips">
              <text class="tip-dot">•</text>
              <text class="tip-text">{{tip}}</text>
            </div>
          </div>
          <div if="{{lightingAdvice}}" class="mid-card">
            <text class="mid-card-title">用  光</text>
            <text class="tip-text-single">{{lightingAdvice}}</text>
          </div>
          <div if="{{extraTips}}" class="mid-card">
            <text class="mid-card-title">提  示</text>
            <text class="tip-text-single">{{extraTips}}</text>
          </div>
        </div>

        <div class="outer-card">
          <param-panel params="{{params}}" scene="{{scene}}"></param-panel>
        </div>

        <div class="preview-section">
          <camera-box grid-mode="{{gridMode}}"></camera-box>
          <div class="grid-row">
            <grid-control value="{{gridMode}}" @change="onGridChange"></grid-control>
          </div>
          <div if="{{scene}}" class="scene-bar">
            <scene-tag name="{{scene}}"></scene-tag>
          </div>
          <div class="shoot-spacer">
            <shoot-button @click="onTakePhoto"></shoot-button>
          </div>
        </div>

      </list-item>
    </list>

    <div if="{{loading}}" style="position:absolute;top:0;left:0;right:0;bottom:0;background-color:rgba(237,242,248,0.92);justify-content:center;align-items:center;flex-direction:column">
      <text style="font-size:28px;color:#1A1A2E;margin-bottom:8px">{{loadingText}}</text>
      <text style="font-size:24px;color:#86909C">正在识别场景并生成建议</text>
    </div>

    <bottom-nav></bottom-nav>
  </div>
</template>

<script>
import media from '@system.media'
import router from '@system.router'
import { store } from '../store/index'
import { analyzePhoto } from '../services/api'

const SCENE_PRESETS = {
  '夜景': { shutter: '1/50', iso: '1600', aperture: 'f/2.8', wb: '4000K', metering: '点测光', ev: '-0.3 EV', drive: '单次拍摄', focus: '画面中心对焦' },
  '人像': { shutter: '1/250', iso: '200', aperture: 'f/2.8', wb: '5500K', metering: '中央重点', ev: '+0.3 EV', drive: '单次拍摄', focus: '人物面部单点对焦' },
  '风景': { shutter: '1/125', iso: '100', aperture: 'f/8', wb: '5500K', metering: '矩阵测光', ev: '0 EV', drive: '单次拍摄', focus: '全域对焦' },
  '街拍': { shutter: '1/500', iso: '400', aperture: 'f/5.6', wb: '5500K', metering: '矩阵测光', ev: '0 EV', drive: '连拍模式', focus: '中央重点对焦' }
}

export default {
  data: {
    scene: null,
    gridMode: 'off',
    params: { shutter: null, iso: null, aperture: null, wb: null, metering: null, ev: null, drive: null, focus: null },
    compositionTips: [],
    lightingAdvice: '',
    extraTips: '',
    loading: false,
    loadingText: 'AI 分析中...'
  },

  onBack() {
    router.replace({ uri: '/Home' })
  },

  onReady() {
    this.detectScene()
  },

  detectScene() {
    this.scene = '夜景'
    const preset = SCENE_PRESETS['夜景']
    if (preset) {
      this.params = Object.assign({}, preset)
    }
    store.setCameraParams(this.scene, this.params)
  },

  onGridChange(evt) {
    this.gridMode = evt.detail.value
    store.state.camera.gridMode = evt.detail.value
  },

  onTakePhoto() {
    const self = this
    media.takePhoto({
      success: async function (data) {
        self.loading = true
        self.loadingText = 'AI 分析场景中...'
        try {
          const uid = store.state.user.uid || 'device_unknown'
          const result = await analyzePhoto(data.uri, 'shooting', uid)
          self.scene = result.scene || '未知场景'
          self.params = result.camera_params || { shutter: null, iso: null, aperture: null, wb: null, metering: null, ev: null, drive: null, focus: null }
          self.compositionTips = result.composition_tips || []
          self.lightingAdvice = result.lighting_advice || ''
          self.extraTips = result.extra_tips || ''
          store.setCameraParams(self.scene, self.params)
        } catch (e) {
          self.scene = '分析失败'
          self.compositionTips = ['网络异常或服务器错误，请稍后重试']
          self.lightingAdvice = ''
          self.extraTips = ''
        }
        self.loading = false
      },
      fail: function (err) {
        console.log('拍照失败:', err)
      }
    })
  }
}
</script>

<style>
  .back-fixed {
    padding: 14px 20px;
    flex-shrink: 0;
  }

  .back-fixed text {
    font-size: 26px;
    color: #5B8DEE;
  }

  .page {
    flex-direction: column;
    flex: 1;
    background-color: #EDF2F8;
    overflow: hidden;
  }

  .content {
    flex: 1;
    height: 0;
  }

  .content-wrap {
    flex-direction: column;
  }

  .outer-card {
    flex-direction: column;
    margin: 0 16px 10px 16px;
    padding: 0;
    border-radius: 18px;
    background-color: #F4F8FC;
    box-shadow: 0 4px 24px rgba(0,0,0,0.05);
  }

  .scene-bar {
    padding: 0 16px 12px 16px;
  }

  .mid-card {
    flex-direction: column;
    margin: 10px 12px;
    padding: 18px;
    border-radius: 12px;
    background-color: #F0F4FC;
    box-shadow: 0 1px 6px rgba(0,0,0,0.03), inset 0 1px 2px rgba(0,0,0,0.02);
  }

  .mid-card:first-child {
    margin-top: 0;
    padding-top: 22px;
  }

  .mid-card:last-child {
    margin-bottom: 0;
    padding-bottom: 22px;
  }

  .mid-card-title {
    font-size: 26px;
    font-weight: bold;
    color: #595040;
    margin-bottom: 12px;
  }

  .mid-card-desc {
    font-size: 24px;
    color: #86909C;
  }

  .tip-item {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 8px;
  }

  .tip-dot {
    font-size: 24px;
    color: #C4A54A;
    margin-right: 8px;
    margin-top: 1px;
  }

  .tip-text {
    font-size: 24px;
    color: #4E5969;
    line-height: 36px;
    flex: 1;
  }

  .tip-text-single {
    font-size: 24px;
    color: #4E5969;
    line-height: 36px;
  }

  .grid-row {
    padding: 0;
  }

  .shoot-spacer {
    flex-direction: row;
    justify-content: center;
    padding: 20px 0;
  }

  .preview-section {
    flex-direction: column;
    margin: 10px 16px;
    border-radius: 18px;
    background-color: #F4F8FC;
    box-shadow: 0 4px 24px rgba(0,0,0,0.05);
    overflow: hidden;
  }
</style>
