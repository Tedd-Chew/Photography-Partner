<import name="camera-box" src="../Common/CameraBox.ux"></import>
<import name="scene-tag" src="../Common/SceneTag.ux"></import>
<import name="shoot-button" src="../Common/ShootButton.ux"></import>
<import name="param-panel" src="../Common/ParamPanel.ux"></import>
<import name="loading-overlay" src="../Common/LoadingOverlay.ux"></import>
<import name="bottom-nav" src="../Common/BottomNav.ux"></import>

<template>
  <div class="page">
    <div class="back-fixed" onclick="onBack">
      <text>← 返回</text>
    </div>

    <list class="content">
      <list-item if="{{compositionTips.length || lightingAdvice || extraTips}}" type="camera-tips">
        <div class="outer-card">
          <div if="{{compositionTips && compositionTips.length}}" class="mid-card">
            <text class="mid-card-title">构  图</text>
            <div class="tip-item" for="tip in compositionTips">
              <text class="tip-dot">•</text>
              <text class="tip-text">{{tip}}</text>
            </div>
          </div>
          <div if="{{lightingAdvice}}" class="mid-card">
            <text class="mid-card-title">用  光</text>
            <text class="tip-text-single">{{lightingAdvice}}</text>
          </div>
          <div if="{{extraTips}}" class="mid-card">
            <text class="mid-card-title">提  示</text>
            <text class="tip-text-single">{{extraTips}}</text>
          </div>
        </div>
      </list-item>

      <list-item type="camera-params">
        <div class="outer-card">
          <param-panel params="{{params}}" scene="{{scene}}"></param-panel>
        </div>
      </list-item>

      <list-item type="camera-preview">
        <div class="preview-section">
          <camera-box></camera-box>
          <div if="{{scene}}" class="scene-bar">
            <scene-tag name="{{scene}}"></scene-tag>
          </div>
          <div class="shoot-spacer">
            <shoot-button @click="onTakePhoto"></shoot-button>
          </div>
        </div>
      </list-item>
    </list>

    <div if="{{loading}}" style="position:absolute;top:0;left:0;right:0;bottom:0;background-color:rgba(237,242,248,0.92);justify-content:center;align-items:center;flex-direction:column">
      <text style="font-size:28px;color:#1A1A2E;margin-bottom:8px">{{loadingText}}</text>
      <text style="font-size:24px;color:#86909C">正在识别场景并生成建议</text>
    </div>

    <bottom-nav></bottom-nav>
  </div>
</template>

<script>
import media from '@system.media'
import router from '@system.router'
import { store } from '../store/index'
import { analyzePhoto } from '../services/api'

export default {
  data: {
    scene: null,
    params: { shutter: null, iso: null, aperture: null, wb: null, ev: null, drive: null, focus: null },
    compositionTips: [],
    lightingAdvice: '',
    extraTips: '',
    loading: false,
    loadingText: 'AI 分析中...'
  },

  onBack() {
    router.replace({ uri: '/Home' })
  },

  onTakePhoto() {
    if (this._busy) return
    this._busy = true
    var self = this
    media.takePhoto({
      success: function (data) {
        self.loading = true
        self.loadingText = 'AI 分析场景中...'
        var uid = store.state.user.uid || 'device_unknown'
        analyzePhoto(data.uri, 'shooting', uid).then(function (result) {
            self.scene = result.scene || '未知场景'
            self.params = result.camera_params || {}
            self.compositionTips = result.composition_tips || []
            self.lightingAdvice = result.lighting_advice || ''
            self.extraTips = result.extra_tips || ''
            store.setCameraParams(self.scene, self.params)
            self.loading = false
            self._busy = false
          }).catch(function (e) {
            console.log('分析失败:', e)
            self.scene = '分析失败'
            self.compositionTips = ['网络异常或服务器错误，请稍后重试']
            self.loading = false
            self._busy = false
          })
      },
      fail: function (err) {
        console.log('拍照失败:', err)
        self.loading = false
        self._busy = false
      },
      cancel: function () {
        console.log('拍照取消')
        self.loading = false
        self._busy = false
      }
    })
  }
}
</script>

<style>
  .back-fixed {
    padding: 14px 20px;
    flex-shrink: 0;
  }

  .back-fixed text {
    font-size: 26px;
    color: #5B8DEE;
  }

  .page {
    flex-direction: column;
    flex: 1;
    background-color: #EDF2F8;
    overflow: hidden;
  }

  .content {
    flex: 1;
    height: 0;
  }

  .content-wrap {
    flex-direction: column;
  }

  .outer-card {
    flex-direction: column;
    margin: 0 16px 10px 16px;
    padding: 0;
    border-radius: 18px;
    background-color: #F4F8FC;
    box-shadow: 0 4px 24px rgba(0,0,0,0.05);
  }

  .scene-bar {
    padding: 0 16px 12px 16px;
  }

  .mid-card {
    flex-direction: column;
    margin: 10px 12px;
    padding: 18px;
    border-radius: 12px;
    background-color: #F0F4FC;
    box-shadow: 0 1px 6px rgba(0,0,0,0.03), inset 0 1px 2px rgba(0,0,0,0.02);
  }


  .mid-card-title {
    font-size: 26px;
    font-weight: bold;
    color: #595040;
    margin-bottom: 12px;
  }

  .mid-card-desc {
    font-size: 24px;
    color: #86909C;
  }

  .tip-item {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 8px;
  }

  .tip-dot {
    font-size: 24px;
    color: #C4A54A;
    margin-right: 8px;
    margin-top: 1px;
  }

  .tip-text {
    font-size: 24px;
    color: #4E5969;
    line-height: 36px;
    flex: 1;
  }

  .tip-text-single {
    font-size: 24px;
    color: #4E5969;
    line-height: 36px;
  }

  .grid-row {
    padding: 0;
  }

  .shoot-spacer {
    flex-direction: row;
    justify-content: center;
    padding: 20px 0;
  }

  .preview-section {
    flex-direction: column;
    margin: 10px 16px;
    border-radius: 18px;
    background-color: #F4F8FC;
    box-shadow: 0 4px 24px rgba(0,0,0,0.05);
    overflow: hidden;
  }
</style>
