<import name="top-bar" src="../Common/TopBar.ux"></import>
<import name="camera-box" src="../Common/CameraBox.ux"></import>
<import name="scene-tag" src="../Common/SceneTag.ux"></import>
<import name="grid-control" src="../Common/GridControl.ux"></import>
<import name="shoot-button" src="../Common/ShootButton.ux"></import>
<import name="param-panel" src="../Common/ParamPanel.ux"></import>
<import name="loading-overlay" src="../Common/LoadingOverlay.ux"></import>
<import name="bottom-nav" src="../Common/BottomNav.ux"></import>

<template>
  <div class="page">
    <top-bar title="拍摄指导"></top-bar>

    <div class="content">
      <camera-box grid-mode="{{gridMode}}"></camera-box>

      <div if="{{scene}}" class="scene-wrap">
        <scene-tag name="{{scene}}"></scene-tag>
      </div>

      <div if="{{compositionTips && compositionTips.length}}" class="tips-section">
        <text class="tips-section-label">📐 构图建议</text>
        <div class="tip-item" for="tip in compositionTips">
          <text class="tip-text">• {{tip}}</text>
        </div>
      </div>

      <div if="{{lightingAdvice}}" class="tips-section">
        <text class="tips-section-label">💡 用光建议</text>
        <text class="tip-text-single">{{lightingAdvice}}</text>
      </div>

      <div if="{{extraTips}}" class="tips-section">
        <text class="tips-section-label">📝 额外建议</text>
        <text class="tip-text-single">{{extraTips}}</text>
      </div>

      <grid-control value="{{gridMode}}" @change="onGridChange"></grid-control>

      <param-panel params="{{params}}" scene="{{scene}}"></param-panel>

      <shoot-button @click="onTakePhoto"></shoot-button>
    </div>

    <loading-overlay show="{{loading}}" text="{{loadingText}}"></loading-overlay>

    <bottom-nav tabs="{{navTabs}}"></bottom-nav>
  </div>
</template>

<script>
import media from '@system.media'
import { store } from '../store/index'
import { analyzePhoto } from '../services/api'

const SCENE_PRESETS = {
  '夜景': { shutter: '1/50', iso: '1600', aperture: 'f/2.8', wb: '4000K', focus: '画面中心对焦' },
  '人像': { shutter: '1/250', iso: '200', aperture: 'f/2.8', wb: '5500K', focus: '人物面部单点对焦' },
  '风景': { shutter: '1/125', iso: '100', aperture: 'f/8', wb: '5500K', focus: '全域对焦' },
  '街拍': { shutter: '1/500', iso: '400', aperture: 'f/5.6', wb: '5500K', focus: '中央重点对焦' }
}

export default {
  data: {
    scene: null,
    gridMode: 'thirds',
    params: { shutter: null, iso: null, aperture: null, wb: null, focus: null },
    compositionTips: [],
    lightingAdvice: '',
    extraTips: '',
    loading: false,
    loadingText: 'AI 分析中...',
    navTabs: [
      { icon: '📋', label: '历史' },
      { icon: '🖼️', label: '选图' },
      { icon: '🌟', label: '成长' }
    ]
  },

  onReady() {
    this.detectScene()
  },

  detectScene() {
    this.scene = '夜景'
    const preset = SCENE_PRESETS['夜景']
    if (preset) {
      this.params = Object.assign({}, preset)
    }
    store.setCameraParams(this.scene, this.params)
  },

  onGridChange(evt) {
    this.gridMode = evt.detail.value
    store.state.camera.gridMode = evt.detail.value
  },

  onTakePhoto() {
    const self = this
    media.takePhoto({
      success: async function (data) {
        self.loading = true
        self.loadingText = 'AI 分析场景中...'
        try {
          const uid = store.state.user.uid || 'device_unknown'
          const result = await analyzePhoto(data.uri, 'shooting', uid)
          self.scene = result.scene || '未知场景'
          self.params = result.camera_params || { shutter: null, iso: null, aperture: null, wb: null, focus: null }
          self.compositionTips = result.composition_tips || []
          self.lightingAdvice = result.lighting_advice || ''
          self.extraTips = result.extra_tips || ''
          store.setCameraParams(self.scene, self.params)
        } catch (e) {
          self.scene = '分析失败'
          self.compositionTips = ['网络异常或服务器错误，请稍后重试']
          self.lightingAdvice = ''
          self.extraTips = ''
        }
        self.loading = false
      },
      fail: function (err) {
        console.log('拍照失败:', err)
      }
    })
  }
}
</script>

<style>
  .page {
    flex-direction: column;
    flex: 1;
    background-color: #0f0f23;
  }

  .content {
    flex: 1;
    flex-direction: column;
  }

  .scene-wrap {
    padding: 8px 20px;
  }

  .tips-section {
    background-color: #1a1a2e;
    border-radius: 12px;
    padding: 14px 16px;
    margin: 6px 20px;
  }

  .tips-section-label {
    font-size: 15px;
    color: #cccccc;
    font-weight: bold;
    margin-bottom: 8px;
  }

  .tip-item {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 4px;
  }

  .tip-text {
    font-size: 13px;
    color: #aaaaaa;
    line-height: 20px;
  }

  .tip-text-single {
    font-size: 13px;
    color: #aaaaaa;
    line-height: 20px;
  }
</style>
