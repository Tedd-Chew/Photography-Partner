<import name="top-bar" src="../Common/TopBar.ux"></import>
<import name="image-picker" src="../Common/ImagePicker.ux"></import>
<import name="loading-overlay" src="../Common/LoadingOverlay.ux"></import>
<import name="up-btn" src="../apex-ui/components/button/index"></import>
<import name="bottom-nav" src="../Common/BottomNav.ux"></import>

<template>
  <div class="page">
    <top-bar title="选择分析模式"></top-bar>

    <list class="content">
      <list-item type="upload-picker">
        <div class="outer-card picker-outer">
          <image-picker @pick-camera="onTakePhoto" @pick-album="onPickImage"></image-picker>
        </div>
      </list-item>

      <list-item type="upload-mode">
        <div class="outer-card">
          <text class="outer-label">分析模式</text>
          <div class="mode-bar">
            <div class="mode-tab {{mode === 'shooting' ? 'mode-active' : ''}}" onclick="pickShooting">
              <text class="mode-tab-text {{mode === 'shooting' ? 'mode-text-active' : ''}}">拍摄指导</text>
            </div>
            <div class="mode-tab {{mode === 'edit' ? 'mode-active' : ''}}" onclick="pickEdit">
              <text class="mode-tab-text {{mode === 'edit' ? 'mode-text-active' : ''}}">修图建议</text>
            </div>
            <div class="mode-tab {{mode === 'score' ? 'mode-active' : ''}}" onclick="pickScore">
              <text class="mode-tab-text {{mode === 'score' ? 'mode-text-active' : ''}}">评分评价</text>
            </div>
          </div>
        </div>
      </list-item>

      <list-item if="{{selectedImage}}" type="upload-preview">
        <div class="outer-card preview-outer">
          <text class="preview-label">已选择照片</text>
          <image class="preview-img" src="{{selectedImage}}"></image>
        </div>
      </list-item>

      <list-item type="upload-analyze">
        <div class="analyze-wrap">
          <up-btn if="{{selectedImage}}" type="primary" size="large" shape="round" ontap="onAnalyze">开始分析</up-btn>
          <up-btn else type="default" size="large" shape="round" disabled="true">请先选择照片</up-btn>
        </div>
      </list-item>
    </list>

    <div if="{{loading}}" class="loading-wrap">
      <div class="loading-dot"></div>
      <text class="loading-text">{{loadingText}}</text>
      <text class="loading-hint">正在识别场景并生成建议</text>
    </div>

    <bottom-nav></bottom-nav>
  </div>
</template>

<script>
import router from '@system.router'
import media from '@system.media'
import prompt from '@system.prompt'
import { uploadImage, analyzePhoto } from '../services/api'
import { store } from '../store/index'

export default {
  data: {
    selectedImage: null,
    mode: 'shooting',
    loading: false,
    loadingText: '上传中...'
  },

  onInit() {},

  pickShooting: function () { this.mode = 'shooting' },
  pickEdit: function () { this.mode = 'edit' },
  pickScore: function () { this.mode = 'score' },

  onAnalyze: function () {
    if (!this.selectedImage || this._busy) return
    this._busy = true
    store.clearAnalysis()
    var self = this
    self.loading = true
    self.loadingText = '上传中...'

    // 第一步：上传图片（快速，不调 AI）
    uploadImage(self.selectedImage).then(function (uploadResult) {
      console.log('[Upload] step1 ok imageId=' + uploadResult.image_id)
      self.loadingText = 'AI 分析中...'

      // 第二步：触发 AI 分析（可以等久一点）
      analyzePhoto(uploadResult.image_id, self.mode, store.state.user.uid, uploadResult.thumb_url).then(function (result) {
        console.log('[Upload] step2 ok mode=' + result.mode)
        // 如果后端没带 thumb_url，用上传阶段的
        if (!result.thumb_url) result.thumb_url = uploadResult.thumb_url
        store.setAnalysis(result)
        self.loading = false
        self._busy = false
        store.state.localUri = self.selectedImage
        router.push({ uri: '/Result' })
      }).catch(function (e) {
        self.loading = false
        self._busy = false
        var msg = (e && e.error) || '分析失败，请重试'
        console.log('[Upload] step2 fail: ' + msg)
        prompt.showToast({ message: msg, duration: 2 })
      })
    }).catch(function (e) {
      self.loading = false
      self._busy = false
      var msg = (e && e.error) || '上传失败，请重试'
      console.log('[Upload] step1 fail: ' + msg)
      prompt.showToast({ message: msg, duration: 2 })
    })
  },

  onPickImage: function () {
    var self = this
    media.pickImage({
      sizeType: ['compressed'],
      success: function (data) { self.selectedImage = data.uri },
      fail: function (err) { console.log('选择图片失败:', err) }
    })
  },

  onTakePhoto: function () {
    var self = this
    media.takePhoto({
      success: function (data) { self.selectedImage = data.uri },
      fail: function (err) { console.log('拍照失败:', err) }
    })
  }
}
</script>

<style>
  .page {
    flex-direction: column;
    flex: 1;
    background-color: #EDF2F8;
    overflow: hidden;
  }

  .content {
    flex: 1;
    height: 0;
  }

  .content-wrap {
    flex-direction: column;
  }

  .outer-card {
    flex-direction: column;
    margin: 0 16px 10px 16px;
    padding: 20px;
    border-radius: 18px;
    background-color: #F4F8FC;
    box-shadow: 0 4px 24px rgba(0,0,0,0.05);
    transition: opacity 0.15s ease;
  }

  .picker-outer {
    padding: 20px 4px;
  }

  .preview-outer {
    align-items: center;
  }

  .outer-label {
    font-size: 26px;
    font-weight: bold;
    color: #595040;
    margin-bottom: 16px;
  }

  .preview-label {
    font-size: 24px;
    color: #86909C;
    margin-bottom: 10px;
  }

  .preview-img {
    width: 200px;
    height: 200px;
    border-radius: 12px;
    background-color: #DEE6F0;
  }

  .analyze-wrap {
    padding: 12px 16px;
  }

  .mode-bar {
    flex-direction: row;
    justify-content: space-around;
  }

  .mode-tab {
    padding: 12px 18px;
    border-radius: 8px;
    background-color: #E3EAF5;
    transition: background-color 0.25s ease, opacity 0.15s ease;
    justify-content: center;
    align-items: center;
  }

  .mode-tab:active {
    opacity: 0.7;
  }

  .mode-active {
    background-color: #C4A54A;
    box-shadow: 0 2px 8px rgba(196, 165, 74, 0.25);
  }

  .mode-tab-text {
    font-size: 24px;
    color: #86909C;
  }

  .mode-text-active {
    color: #FFFFFF;
    font-weight: bold;
  }

  .loading-wrap {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(237,242,248,0.92);
    justify-content: center;
    align-items: center;
    flex-direction: column;
  }

  .loading-dot {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: #C4A54A;
    margin-bottom: 16px;
  }

  .loading-text {
    font-size: 28px;
    color: #1A1A2E;
    margin-bottom: 8px;
  }

  .loading-hint {
    font-size: 24px;
    color: #86909C;
  }
</style>
