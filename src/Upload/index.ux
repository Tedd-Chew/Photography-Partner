<import name="top-bar" src="../Common/TopBar.ux"></import>
<import name="image-picker" src="../Common/ImagePicker.ux"></import>
<import name="loading-overlay" src="../Common/LoadingOverlay.ux"></import>
<import name="bottom-nav" src="../Common/BottomNav.ux"></import>

<template>
  <div class="page">
    <top-bar title="选择分析模式"></top-bar>

    <image-picker @pick-camera="onTakePhoto" @pick-album="onPickImage"></image-picker>

    <div class="mode-bar">
      <div class="mode-tab {{mode === 'shooting' ? 'mode-active' : ''}}" onclick="pickShooting">
        <text class="mode-tab-text {{mode === 'shooting' ? 'mode-text-active' : ''}}">拍摄指导</text>
      </div>
      <div class="mode-tab {{mode === 'edit' ? 'mode-active' : ''}}" onclick="pickEdit">
        <text class="mode-tab-text {{mode === 'edit' ? 'mode-text-active' : ''}}">修图建议</text>
      </div>
      <div class="mode-tab {{mode === 'score' ? 'mode-active' : ''}}" onclick="pickScore">
        <text class="mode-tab-text {{mode === 'score' ? 'mode-text-active' : ''}}">评分评价</text>
      </div>
    </div>

    <div if="{{selectedImage}}" class="preview-wrap">
      <text class="preview-label">已选择照片</text>
      <image class="preview-img" src="{{selectedImage}}"></image>
    </div>

    <div class="analyze-wrap">
      <div if="{{selectedImage}}" class="analyze-btn" onclick="onAnalyze">
        <text class="analyze-btn-text">开始分析</text>
      </div>
      <div else class="analyze-btn-disabled">
        <text class="analyze-btn-text-disabled">请先选择照片</text>
      </div>
    </div>

    <loading-overlay show="{{loading}}"></loading-overlay>

    <bottom-nav tabs="{{navTabs}}"></bottom-nav>
  </div>
</template>

<script>
import router from '@system.router'
import media from '@system.media'
import { analyzePhoto } from '../services/api'
import { store } from '../store/index'

export default {
  data: {
    selectedImage: null,
    mode: 'shooting',
    loading: false,
    navTabs: [
      { label: '历史' },
      { label: '选图' },
      { label: '成长' }
    ]
  },

  onInit() {
    store.clearAnalysis()
  },

  onPickImage() {
    const self = this
    media.pickImage({
      success: function (data) {
        self.selectedImage = data.uri
      },
      fail: function (err) {
        console.log('选择图片失败:', err)
      }
    })
  },

  onTakePhoto() {
    const self = this
    media.takePhoto({
      success: function (data) {
        self.selectedImage = data.uri
      },
      fail: function (err) {
        console.log('拍照失败:', err)
      }
    })
  },

  pickShooting() { this.mode = 'shooting' },
  pickEdit() { this.mode = 'edit' },
  pickScore() { this.mode = 'score' },

  async onAnalyze() {
    if (!this.selectedImage) return

    this.loading = true
    try {
      const result = await analyzePhoto(this.selectedImage, this.mode)
      store.setAnalysis(result)
      this.loading = false
      this.$app.navigateTo('Result', { result, localUri: this.selectedImage })
    } catch (e) {
      this.loading = false
    }
  }
}
</script>

<style>
  .page {
    flex-direction: column;
    flex: 1;
    background-color: #0f0f23;
  }

  .preview-wrap {
    flex-direction: column;
    align-items: center;
    padding: 12px 20px;
  }

  .preview-label {
    font-size: 13px;
    color: #888888;
    margin-bottom: 8px;
  }

  .preview-img {
    width: 200px;
    height: 200px;
    border-radius: 12px;
    background-color: #1a1a2e;
  }

  .analyze-wrap {
    padding: 16px 20px;
  }

  .analyze-btn {
    justify-content: center;
    align-items: center;
    padding: 16px;
    border-radius: 12px;
    background-color: #ffd700;
  }

  .analyze-btn-disabled {
    justify-content: center;
    align-items: center;
    padding: 16px;
    border-radius: 12px;
    background-color: #555555;
  }

  .analyze-btn-text {
    font-size: 16px;
    font-weight: bold;
    color: #000000;
  }

  .analyze-btn-text-disabled {
    font-size: 16px;
    font-weight: bold;
    color: #888888;
  }

  .mode-bar {
    flex-direction: row;
    justify-content: space-around;
    padding: 12px 20px;
  }

  .mode-tab {
    padding: 10px 20px;
    border-radius: 8px;
    background-color: #1a1a2e;
  }

  .mode-active {
    background-color: #ffd700;
  }

  .mode-tab-text {
    font-size: 14px;
    color: #888888;
  }

  .mode-text-active {
    color: #000000;
    font-weight: bold;
  }
</style>
