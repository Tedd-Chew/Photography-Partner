<import name="lu-icon" src="../apex-ui/components/icon/index"></import>

<template>
  <div>
  <div class="level-up-card" if="{{show}}">
    <lu-icon type="gift" size="32" color="#ffd700"></lu-icon>
    <text class="level-up-text">升级了！</text>
    <text class="level-up-detail">{{oldName}} → {{newName}}</text>
  </div>
</div>
</template>

<script>
export default {
  props: {
    oldName: { default: '' },
    newName: { default: '' }
  },

  computed: {
    show() {
      return !!(this.oldName && this.newName)
    }
  }
}
</script>

<style>
  .level-up-card {
    flex-direction: column;
    align-items: center;
    background-color: #1e2a1e;
    border-radius: 12px;
    padding: 16px;
    margin: 8px 20px;
  }

  .level-up-icon {
    margin-bottom: 6px;
  }

  .level-up-text {
    font-size: 18px;
    color: #4caf50;
    font-weight: bold;
  }

  .level-up-detail {
    font-size: 13px;
    color: #81c784;
    margin-top: 4px;
  }
</style>
