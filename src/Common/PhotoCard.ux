<import name="my-card" src="../apex-ui/components/card/index"></import>
<import name="pc-icon" src="../apex-ui/components/icon/index"></import>

<template>
  <my-card>
    <div slot="title" class="card-title-wrap">
      <text class="card-mode-tag" style="color: {{modeColor}};">{{modeLabel}}</text>
      <pc-icon type="image" size="14" color="#86909C"></pc-icon>
    </div>
    <div class="card-body">
      <text class="card-summary">{{summary}}</text>
    </div>
  </my-card>
</template>

<script>
export default {
  props: {
    item: { default: () => ({ mode: '', score: 0, summary: '' }) }
  },

  computed: {
    modeLabel: function () {
      const map = { shooting: '拍摄指导', edit: '修图建议', score: '评分评价' }
      return map[this.item.mode] || ''
    },
    modeColor: function () {
      const map = { shooting: '#5B8DEE', edit: '#9B70D6', score: '#C4A54A' }
      return map[this.item.mode] || '#C4A54A'
    },
    summary: function () {
      return this.item.summary || ''
    }
  }
}
</script>

<style>
  .card-title-wrap {
    flex-direction: row;
    align-items: center;
  }

  .card-mode-tag {
    font-size: 24px;
    font-weight: bold;
    margin-right: 6px;
  }

  .card-body {
    flex-direction: column;
  }

  .card-summary {
    font-size: 24px;
    color: #4E5969;
    margin-top: 4px;
    line-height: 36px;
    max-lines: 2;
    text-overflow: ellipsis;
  }
</style>
