  }

  .dim-score {
    width: 28px;
    font-size: 14px;
    color: #ffffff;
    font-weight: bold;
    text-align: right;
  }

  .dim-weight {
    width: 36px;
    font-size: 12px;
    color: #666666;
    text-align: right;
    margin-left: 4px;
  }
</style>
