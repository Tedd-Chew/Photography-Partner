<import name="sr-icon" src="../apex-ui/components/icon/index"></import>

<template>
  <div class="radar-chart">
    <div class="radar-title">
      <sr-icon type="stats" size="16" color="#ffd700"></sr-icon>
      <text class="section-label">五维评分</text>
    </div>

    <div class="dimension-row" for="d in dimensions">
      <text class="dim-name">{{d.label}}</text>
      <div class="bar-track">
        <div class="bar-fill" style="width: {{d.value}}%; background-color: {{d.color}};"></div>
      </div>
      <text class="dim-score">{{d.value}}</text>
      <text class="dim-weight">{{d.weight}}%</text>
    </div>
  </div>
</template>

<script>
export default {
  props: {
    scores: {
      default: () => ({ composition: 0, exposure: 0, color: 0, sharpness: 0, creativity: 0 })
    }
  },

  computed: {
    dimensions() {
      return [
        { label: '构图', value: this.scores.composition || 0, color: '#ff6b6b', weight: 30 },
        { label: '曝光', value: this.scores.exposure || 0, color: '#ffd93d', weight: 25 },
        { label: '色彩', value: this.scores.color || 0, color: '#6bcb77', weight: 20 },
        { label: '清晰度', value: this.scores.sharpness || 0, color: '#4d96ff', weight: 15 },
        { label: '创意', value: this.scores.creativity || 0, color: '#c084fc', weight: 10 }
      ]
    }
  }
}
</script>

