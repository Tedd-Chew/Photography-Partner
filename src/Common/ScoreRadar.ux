    background-color: #1a1a2e;
    border-radius: 12px;
    padding: 16px;
    margin: 12px 20px;
  }

  .radar-title {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
  }

  .section-icon {
    margin-right: 6px;
  }

  .section-label {
    font-size: 16px;
    font-weight: bold;
    color: #cccccc;
  }

  .dimension-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
  }

  .dim-name {
    width: 56px;
    font-size: 14px;
    color: #cccccc;
  }

  .bar-track {
    flex: 1;
    height: 8px;
    border-radius: 4px;
    background-color: #2a2a3e;
    margin-left: 8px;
    margin-right: 8px;
  }

  .bar-fill {
    height: 8px;
