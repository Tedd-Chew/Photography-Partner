<import name="sr-icon" src="../apex-ui/components/icon/index"></import>

<template>
  <div class="radar-chart">
    <div class="radar-title">
      <sr-icon type="stats" size="16" color="#C4A54A"></sr-icon>
      <text class="section-label">五维评分</text>
    </div>
    <canvas class="radar-canvas" id="radar-canvas"></canvas>
  </div>
</template>

<script>
import Charts from '../apex-ui/components/charts/qacharts-min'

let $chart = null

export default {
  props: {
    scores: {
      default: () => ({ composition: 0, exposure: 0, color: 0, sharpness: 0, creativity: 0 })
    }
  },

  data: {
    drawn: false
  },

  onReady() {
    this.drawChart()
  },

  drawChart() {
    const el = this.$element('radar-canvas')
    if (!el) return
    const s = this.scores
    $chart = new Charts({
      element: el,
      width: 600,
      height: 440,
      backgroundColor: '#F4F8FC',
      radarAxis: {
        axisLabel: { color: '#86909C', fontSize: 11 },
        axisLine: { color: '#D0DAE8' },
        splitLine: { color: '#DCE4F0' },
        splitArea: { show: true, color: ['rgba(100,130,180,0.02)', 'rgba(100,130,180,0.04)'] }
      },
      category: [
        { name: '构图\n' + (s.composition || 0) },
        { name: '曝光\n' + (s.exposure || 0) },
        { name: '色彩\n' + (s.color || 0) },
        { name: '清晰度\n' + (s.sharpness || 0) },
        { name: '创意\n' + (s.creativity || 0) }
      ],
      series: [{
        name: '评分',
        type: 'radar',
        data: [s.composition || 0, s.exposure || 0, s.color || 0, s.sharpness || 0, s.creativity || 0],
        symbol: 'circle',
        symbolSize: 4,
        lineColor: '#C4A54A',
        areaColor: 'rgba(196, 165, 74, 0.12)',
        itemColor: '#C4A54A'
      }],
      onRenderComplete: function () {
        this.drawn = true
      }
    })
  }
}
</script>

<style>
  .radar-chart {
    background-color: #F0F4FC;
    border-radius: 12px;
    padding: 16px;
    margin: 0 8px;
    background-color: #E8EFF7;
    flex-direction: column;
    box-shadow: 0 1px 6px rgba(0,0,0,0.03), inset 0 1px 2px rgba(0,0,0,0.02);
  }

  .radar-title {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
  }

  .section-label {
    font-size: 28px;
    font-weight: bold;
    color: #595040;
    margin-left: 6px;
  }

  .radar-canvas {
    width: 568px;
    height: 380px;
  }
</style>
