<template>
  <div class="issue-card" style="border-left-color: {{borderColor}};">
    <div class="issue-header">
      <div class="severity-tag {{severityClass}}">
        <text class="severity-text" style="color: {{severityColor}};">{{severityText}}</text>
      </div>
      <text class="issue-category">{{item.category}}</text>
    </div>
    <text class="issue-desc">{{item.description}}</text>
    <div class="issue-suggestion">
      <text class="suggestion-label">建议：</text>
      <text class="suggestion-text">{{item.suggestion}}</text>
    </div>
  </div>
</template>

<script>
export default {
  props: {
    item: {
      default: () => ({ severity: 'medium', category: '', description: '', suggestion: '' })
    }
  },

  computed: {
    severityText() {
      const map = { high: '严重', medium: '中等', low: '轻微' }
      return map[this.item.severity] || '中等'
    },
    severityClass() {
      return 'severity-' + (this.item.severity || 'medium')
    },
    borderColor() {
      const map = { high: '#D4686A', medium: '#D4894A', low: '#5BAA6E' }
      return map[this.item.severity] || '#D4894A'
    },
    severityColor() {
      const map = { high: '#D4686A', medium: '#D4894A', low: '#5BAA6E' }
      return map[this.item.severity] || '#D4894A'
    }
  }
}
</script>

<style>
  .issue-card {
    border-radius: 10px;
    padding: 14px 16px;
    border-left-width: 3px;
    border-left-color: #D4686A;
    background-color: #F0F4FC;
    box-shadow: 0 1px 6px rgba(0,0,0,0.03), inset 0 1px 2px rgba(0,0,0,0.02);
    transition: opacity 0.15s ease;
  }

  .issue-card:active {
    opacity: 0.8;
  }

  .issue-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
  }

  .severity-tag {
    padding: 2px 8px;
    border-radius: 8px;
    margin-right: 8px;
  }

  .severity-high {
    background-color: rgba(212, 104, 106, 0.12);
  }

  .severity-medium {
    background-color: rgba(212, 137, 74, 0.12);
  }

  .severity-low {
    background-color: rgba(91, 170, 110, 0.12);
  }

  .severity-text {
    font-size: 22px;
    color: #D4686A;
    font-weight: bold;
  }

  .issue-category {
    font-size: 26px;
    color: #595040;
    font-weight: bold;
  }

  .issue-desc {
    font-size: 24px;
    color: #4E5969;
    margin-bottom: 6px;
  }

  .issue-suggestion {
    flex-direction: row;
  }

  .suggestion-label {
    font-size: 24px;
    color: #86909C;
  }

  .suggestion-text {
    font-size: 24px;
    color: #5B8DEE;
    flex: 1;
  }
</style>
