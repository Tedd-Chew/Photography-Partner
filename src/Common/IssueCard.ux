<template>
  <div class="issue-card" style="border-left-color: {{borderColor}};">
    <div class="issue-header">
      <div class="severity-tag {{severityClass}}">
        <text class="severity-text" style="color: {{severityColor}};">{{severityText}}</text>
      </div>
      <text class="issue-category">{{item.category}}</text>
    </div>
    <text class="issue-desc">{{item.description}}</text>
    <div class="issue-suggestion">
      <text class="suggestion-label">建议：</text>
      <text class="suggestion-text">{{item.suggestion}}</text>
    </div>
  </div>
</template>

<script>
export default {
  props: {
    item: {
      default: () => ({ severity: 'medium', category: '', description: '', suggestion: '' })
    }
  },

  computed: {
    severityText() {
      const map = { high: '严重', medium: '中等', low: '轻微' }
      return map[this.item.severity] || '中等'
    },
    severityClass() {
      return 'severity-' + (this.item.severity || 'medium')
    },
    severityColor() {
      const map = { high: '#f44336', medium: '#ff9800', low: '#4caf50' }
      return map[this.item.severity] || '#ff9800'
    },
    borderColor() {
      const map = { high: '#f44336', medium: '#ff9800', low: '#4caf50' }
      return map[this.item.severity] || '#ff9800'
    }
  }
}
</script>

<style>
  .issue-card {
    background-color: #1a1a2e;
    border-radius: 12px;
    padding: 14px 16px;
    margin: 6px 20px;
    border-left-width: 3px;
    border-left-color: #f44336;
  }

  .issue-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
  }

  .severity-tag {
    padding: 2px 8px;
    border-radius: 4px;
    margin-right: 8px;
  }

  .severity-high {
    background-color: rgba(244, 67, 54, 0.2);
  }

  .severity-medium {
    background-color: rgba(255, 152, 0, 0.2);
  }

  .severity-low {
    background-color: rgba(76, 175, 80, 0.2);
  }

  .severity-text {
    font-size: 12px;
    color: #f44336;
    font-weight: bold;
  }

  .issue-category {
    font-size: 15px;
    color: #ffffff;
    font-weight: bold;
  }

  .issue-desc {
    font-size: 14px;
    color: #cccccc;
    margin-bottom: 6px;
  }

  .issue-suggestion {
    flex-direction: row;
  }

  .suggestion-label {
    font-size: 13px;
    color: #888888;
  }

  .suggestion-text {
    font-size: 13px;
    color: #4d96ff;
    flex: 1;
  }
</style>
