<template>
  <div class="level-badge">
    <div class="badge-circle" style="border-color: {{levelColor}};">
      <text class="badge-lv-label" style="color: {{levelColor}};">Lv</text>
      <text class="badge-lv-num" style="color: {{levelColor}};">{{level}}</text>
    </div>
    <div class="level-info">
      <text class="level-name">{{levelName}}</text>
      <progress class="exp-bar" type="horizontal" percent="{{progress}}" style="layer-color: #DEE6F0; progress-color: {{levelColor}};"></progress>
      <text class="exp-text">{{exp}} / {{expToNext}}</text>
    </div>
  </div>
</template>

<script>
const LEVEL_COLORS = {
  '1': '#9e9e9e',
  '2': '#8ABA8E',
  '3': '#5BA4C8',
  '4': '#9B6BB8',
  '5': '#C4A54A',
  '6': '#D47A30'
}

export default {
  props: {
    level: { default: 1 },
    levelName: { default: '初学者' },
    exp: { default: 0 },
    expToNext: { default: 100 }
  },

  computed: {
    progress: function () {
      if (!this.expToNext) return 0
      return Math.min(100, (this.exp / this.expToNext) * 100)
    },
    levelColor: function () {
      return LEVEL_COLORS[String(this.level)] || '#9e9e9e'
    }
  }
}
</script>

<style>
  .level-badge {
    flex-direction: row;
    align-items: center;
    background-color: #F0F4FC;
    border-radius: 12px;
    padding: 16px;
    margin: 0 8px;
    background-color: #E8EFF7;
    box-shadow: 0 1px 6px rgba(0,0,0,0.03), inset 0 1px 2px rgba(0,0,0,0.02);
  }

  .badge-circle {
    width: 72px;
    height: 72px;
    border-radius: 36px;
    border: 4px solid #5BA4C8;
    background-color: rgba(91, 164, 200, 0.08);
    justify-content: center;
    align-items: center;
    flex-direction: column;
    margin-right: 16px;
  }

  .badge-lv-label {
    font-size: 22px;
  }

  .badge-lv-num {
    font-size: 40px;
    font-weight: bold;
  }

  .level-info {
    flex: 1;
    flex-direction: column;
  }

  .level-name {
    font-size: 30px;
    font-weight: bold;
    color: #595040;
    margin-bottom: 8px;
  }

  .exp-bar {
    height: 6px;
    margin-bottom: 4px;
  }

  .exp-text {
    font-size: 22px;
    color: #86909C;
  }
</style>
