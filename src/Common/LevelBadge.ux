<template>
  <div class="level-badge-wrap">
    <div class="badge-circle" style="border-color: {{levelColor}}; background-color: {{levelBg}};">
      <text class="badge-lv-label" style="color: {{levelColor}};">Lv</text>
      <text class="badge-lv-num" style="color: {{levelColor}};">{{level}}</text>
    </div>

    <div class="level-info">
      <text class="level-name">{{levelName}}</text>
      <div class="exp-bar-track">
        <div class="exp-bar-fill" style="width: {{progress}}%; background-color: {{levelColor}};"></div>
      </div>
      <text class="exp-text">{{exp}} / {{expToNext}}</text>
    </div>
  </div>
</template>

<script>
const LEVEL_COLORS = {
  1: '#9e9e9e',
  2: '#81c784',
  3: '#4fc3f7',
  4: '#ba68c8',
  5: '#ffd700',
  6: '#ff6d00'
}

export default {
  props: {
    level: { default: 1 },
    exp: { default: 0 },
    expToNext: { default: 0 },
    levelName: { default: '' }
  },

  computed: {
    levelColor() {
      return LEVEL_COLORS[this.level] || '#9e9e9e'
    },
    levelBg() {
      const c = this.levelColor
      return c + '1a'
    },
    progress() {
      if (!this.expToNext) return 100
      return Math.min(100, Math.round(this.exp / this.expToNext * 100))
    }
  }
}
</script>

<style>
  .level-badge-wrap {
    flex-direction: row;
    align-items: center;
    background-color: #1a1a2e;
    border-radius: 12px;
    padding: 16px;
    margin: 0 20px;
  }

  .badge-circle {
    width: 72px;
    height: 72px;
    border-radius: 36px;
    border: 4px solid #4fc3f7;
    background-color: rgba(79, 195, 247, 0.1);
    justify-content: center;
    align-items: center;
    flex-direction: column;
    margin-right: 16px;
  }

  .badge-lv-label {
    font-size: 12px;
    color: #4fc3f7;
  }

  .badge-lv-num {
    font-size: 28px;
    font-weight: bold;
    color: #4fc3f7;
  }

  .level-info {
    flex: 1;
    flex-direction: column;
  }

  .level-name {
    font-size: 18px;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 8px;
  }

  .exp-bar-track {
    height: 6px;
    border-radius: 3px;
    background-color: #2a2a3e;
    margin-bottom: 4px;
  }

  .exp-bar-fill {
    height: 6px;
    border-radius: 3px;
    background-color: #4fc3f7;
  }

  .exp-text {
    font-size: 12px;
    color: #888888;
  }
</style>
