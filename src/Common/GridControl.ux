<template>
  <div class="grid-control">
    <text class="control-label">构图线: {{label}}</text>
    <div class="grid-btns">
      <div class="grid-btn {{value === 'off' ? 'active' : ''}}" onclick="onChange('off')">
        <text>关闭</text>
      </div>
      <div class="grid-btn {{value === 'thirds' ? 'active' : ''}}" onclick="onChange('thirds')">
        <text>三分法</text>
      </div>
      <div class="grid-btn {{value === 'golden' ? 'active' : ''}}" onclick="onChange('golden')">
        <text>黄金分割</text>
      </div>
      <div class="grid-btn {{value === 'crosshair' ? 'active' : ''}}" onclick="onChange('crosshair')">
        <text>十字线</text>
      </div>
    </div>
  </div>
</template>

<script>
export default {
  props: {
    value: { default: 'thirds' }
  },

  computed: {
    label() {
      const map = { off: '关闭', thirds: '三分法', golden: '黄金分割', crosshair: '十字线' }
      return map[this.value] || '三分法'
    }
  },

  onChange(mode) {
    this.$emit('change', mode)
  }
}
</script>

<style>
  .grid-control {
    flex-direction: column;
    padding: 12px 15px;
    background-color: #111111;
    border-top: 1px solid #222222;
  }

  .control-label {
    font-size: 13px;
    color: #888888;
    margin-bottom: 8px;
  }

  .grid-btns {
    flex-direction: row;
  }

  .grid-btn {
    padding: 6px 14px;
    margin-right: 8px;
    border-radius: 6px;
    background-color: #222222;
  }

  .grid-btn text {
    font-size: 12px;
    color: #ffffff;
  }

  .grid-btn.active {
    background-color: #ffd700;
  }

  .grid-btn.active text {
    color: #000000;
  }
</style>
