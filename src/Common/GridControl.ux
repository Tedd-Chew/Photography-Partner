<template>
  <div class="grid-control">
    <text class="control-label">构图线: {{label}}</text>
    <div class="grid-btns">
      <div class="grid-btn {{value === 'off' ? 'btn-active' : ''}}" onclick="selectOff">
        <text>关闭</text>
      </div>
      <div class="grid-btn {{value === 'thirds' ? 'btn-active' : ''}}" onclick="selectThirds">
        <text>三分法</text>
      </div>
      <div class="grid-btn {{value === 'golden' ? 'btn-active' : ''}}" onclick="selectGolden">
        <text>黄金分割</text>
      </div>
      <div class="grid-btn {{value === 'crosshair' ? 'btn-active' : ''}}" onclick="selectCrosshair">
        <text>十字线</text>
      </div>
    </div>
  </div>
</template>

<script>
export default {
  props: {
    value: { default: 'off' }
  },

  computed: {
    label() {
      const map = { off: '关闭', thirds: '三分法', golden: '黄金分割', crosshair: '十字线' }
      return map[this.value] || '三分法'
    }
  },

  selectOff() { this.$dispatch('change', { value: 'off' }) },
  selectThirds() { this.$dispatch('change', { value: 'thirds' }) },
  selectGolden() { this.$dispatch('change', { value: 'golden' }) },
  selectCrosshair() { this.$dispatch('change', { value: 'crosshair' }) }
}
</script>

<style>
  .grid-control {
    flex-direction: column;
    padding: 14px 15px;
  }

  .control-label {
    font-size: 24px;
    color: #86909C;
    margin-bottom: 8px;
  }

  .grid-btns {
    flex-direction: row;
  }

  .grid-btn {
    padding: 8px 16px;
    margin-right: 8px;
    border-radius: 8px;
    background-color: #E3EAF5;
    justify-content: center;
    align-items: center;
    transition: background-color 0.25s ease, opacity 0.15s ease;
    opacity: 1;
  }

  .grid-btn:active {
    opacity: 0.7;
  }

  .grid-btn text {
    font-size: 22px;
    color: #595040;
  }

  .btn-active {
    background-color: #C4A54A;
    box-shadow: 0 2px 8px rgba(196, 165, 74, 0.25);
  }

  .btn-active text {
    color: #FFFFFF;
  }
</style>
