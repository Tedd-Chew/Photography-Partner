<script>
export default {
  props: {
    scores: {
      default: {
        composition: 0,
        exposure: 0,
        color: 0,
        sharpness: 0,
        creativity: 0
      }
    }
  },

  data: {
    dimensions: [
      { key: 'composition', label: '构图', weight: 30, color: '#ff6b6b' },
      { key: 'exposure', label: '曝光', weight: 25, color: '#ffd93d' },
      { key: 'color', label: '色彩', weight: 20, color: '#6bcb77' },
      { key: 'sharpness', label: '清晰度', weight: 15, color: '#4d96ff' },
      { key: 'creativity', label: '创意', weight: 10, color: '#c084fc' }
    ]
  },

  getScore(key) {
    const s = this.scores || {}
    return s[key] || 0
  },

  getBarWidth(key) {
    return this.getScore(key) + '%'
  },

  getScoreColor(score) {
    if (score >= 90) return '#4caf50'
    if (score >= 80) return '#8bc34a'
    if (score >= 70) return '#ffd700'
    if (score >= 60) return '#ff9800'
    return '#f44336'
  },

  getScoreLabel(score) {
    if (score >= 90) return '优秀'
    if (score >= 80) return '良好'
    if (score >= 70) return '中等'
    if (score >= 60) return '一般'
    return '需改进'
  }
}
</script>

<template>
  <div class="radar-container">
    <text class="radar-title">五维评分</text>
    <div for="dim in dimensions" class="dim-row">
      <div class="dim-header">
        <text class="dim-label">{{dim.label}}</text>
        <text class="dim-weight">{{dim.weight}}%</text>
        <text class="dim-score" style="color: {{getScoreColor(getScore(dim.key))}}">{{getScore(dim.key)}}</text>
      </div>
      <div class="bar-track">
        <div class="bar-fill" style="width: {{getBarWidth(dim.key)}}; background-color: {{dim.color}};"></div>
      </div>
    </div>
    <div class="legend">
      <div for="dim in dimensions" class="legend-item">
        <div class="legend-dot" style="background-color: {{dim.color}};"></div>
        <text class="legend-text">{{dim.label}} {{dim.weight}}%</text>
      </div>
    </div>
  </div>
</template>

<style>
  .radar-container {
    flex-direction: column;
    padding: 16px;
    margin: 0 20px;
    border-radius: 12px;
    background-color: #1a1a2e;
  }

  .radar-title {
    font-size: 16px;
    font-weight: bold;
    color: #fff;
    margin-bottom: 14px;
  }

  .dim-row {
    flex-direction: column;
    margin-bottom: 10px;
  }

  .dim-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
  }

  .dim-label {
    font-size: 13px;
    color: #aaa;
    width: 50px;
  }

  .dim-weight {
    font-size: 11px;
    color: #555;
    width: 30px;
    text-align: right;
  }

  .dim-score {
    font-size: 14px;
    font-weight: bold;
    width: 40px;
    text-align: right;
  }

  .bar-track {
    height: 8px;
    border-radius: 4px;
    background-color: #2a2a3e;
  }

  .bar-fill {
    height: 8px;
    border-radius: 4px;
  }

  .legend {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 10px;
  }

  .legend-item {
    flex-direction: row;
    align-items: center;
    margin-right: 12px;
    margin-top: 4px;
  }

  .legend-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 4px;
  }

  .legend-text {
    font-size: 11px;
    color: #666;
  }
</style>
