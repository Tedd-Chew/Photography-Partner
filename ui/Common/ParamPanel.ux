<script>
export default {
  props: {
    params: {
      default: null
    },
    scene: {
      default: ''
    }
  },

  computed: {
    hasParams: function () {
      return this.params !== null && this.params !== undefined
    },

    paramItems: function () {
      if (!this.hasParams) {
        return [
          { label: '快门速度', value: '--', icon: '⏱' },
          { label: 'ISO 感光度', value: '--', icon: '📊' },
          { label: '光圈', value: '--', icon: '🔆' },
          { label: '白平衡', value: '--', icon: '🎨' },
          { label: '对焦点', value: '--', icon: '🎯' }
        ]
      }

      const p = this.params
      return [
        { label: '快门速度', value: p.shutter || '--', icon: '⏱' },
        { label: 'ISO 感光度', value: p.iso || '--', icon: '📊' },
        { label: '光圈', value: p.aperture || '--', icon: '🔆' },
        { label: '白平衡', value: p.wb || '--', icon: '🎨' },
        { label: '对焦点', value: p.focus || '--', icon: '🎯' }
      ]
    }
  }
}
</script>

<template>
  <div class="param-panel">
    <div if="{{scene}}" class="scene-tag">
      <text class="scene-icon">📍</text>
      <text class="scene-text">{{scene}}</text>
    </div>

    <text class="panel-title">推荐参数</text>

    <div class="params-grid">
      <div for="item in paramItems" class="param-item">
        <text class="param-icon">{{item.icon}}</text>
        <text class="param-label">{{item.label}}</text>
        <text class="param-value {{hasParams && params.shutter ? 'active' : ''}}">{{item.value}}</text>
      </div>
    </div>
  </div>
</template>

<style>
  .param-panel {
    flex-direction: column;
    padding: 16px;
    margin: 0 20px;
    border-radius: 12px;
    background: linear-gradient(135deg, #1a1a2e, #222244);
  }

  .scene-tag {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    padding: 4px 12px;
    margin-bottom: 12px;
    border-radius: 14px;
    background-color: rgba(255, 215, 0, 0.15);
  }

  .scene-icon {
    font-size: 12px;
    margin-right: 4px;
  }

  .scene-text {
    font-size: 13px;
    color: #ffd700;
    font-weight: bold;
  }

  .panel-title {
    font-size: 16px;
    font-weight: bold;
    color: #fff;
    margin-bottom: 12px;
  }

  .params-grid {
    flex-direction: row;
    flex-wrap: wrap;
  }

  .param-item {
    flex-direction: column;
    align-items: center;
    width: 33.33%;
    padding: 10px 4px;
  }

  .param-icon {
    font-size: 20px;
    margin-bottom: 4px;
  }

  .param-label {
    font-size: 11px;
    color: #888;
    margin-bottom: 4px;
  }

  .param-value {
    font-size: 13px;
    color: #666;
    font-weight: bold;
  }

  .param-value.active {
    color: #ffd700;
  }
</style>
