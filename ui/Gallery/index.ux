<script>
import router from '@system.router'
import { store } from '../store/index.js'
import { getGallery, getGalleryDetail } from '../services/api.js'

export default {
  data: {
    items: [],
    page: 1,
    total: 0,
    loading: true
  },

  async onInit() {
    this.loadHistory()
  },

  async loadHistory() {
    this.loading = true
    try {
      const res = await getGallery()
      if (res.ok) {
        this.items = res.data.items || []
        this.total = res.data.total || 0
        store.setHistory(this.items)
      }
    } catch (e) {
      console.log('加载历史失败:', e)
    } finally {
      this.loading = false
    }
  },

  async goToDetail(id) {
    try {
      const res = await getGalleryDetail(id)
      if (res.ok) {
        store.setAnalysis(res.data)
        router.push({ uri: '/Result' })
      }
    } catch (e) {
      this.showToast('加载详情失败')
    }
  },

  onCardClick(evt) {
    this.goToDetail(evt.detail.id)
  },

  goBack() {
    router.back()
  },

  showToast(msg) {
    try {
      const prompt = require('@system.prompt')
      prompt.showToast({ message: msg, duration: 1 })
    } catch (e) {
      console.log(msg)
    }
  }
}
</script>

<template>
  <div class="gallery-page">
    <div class="header">
      <div class="back-btn" onclick="goBack">
        <text>← 返回</text>
      </div>
      <text class="header-title">历史记录</text>
      <div class="header-right"></div>
    </div>

    <div if="{{loading}}" class="loading-area">
      <progress type="circular"></progress>
      <text class="loading-text">加载中...</text>
    </div>

    <div if="{{!loading && items.length === 0}}" class="empty-area">
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂无分析记录</text>
      <text class="empty-hint">去分析一张照片吧</text>
    </div>

    <import name="photo-card" src="../Common/PhotoCard"></import>

    <list class="gallery-list">
      <list-item for="item in items">
        <photo-card item="{{item}}" onclick="onCardClick"></photo-card>
      </list-item>
    </list>
  </div>
</template>

<style>
  .gallery-page {
    flex-direction: column;
    background-color: #0f0f23;
    min-height: 100vh;
  }

  .header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    background-color: #1a1a2e;
  }

  .back-btn text {
    font-size: 15px;
    color: #ffd700;
  }

  .header-title {
    font-size: 18px;
    font-weight: bold;
    color: #fff;
  }

  .header-right {
    width: 60px;
  }

  .loading-area {
    flex-direction: column;
    align-items: center;
    padding: 60px;
  }

  .loading-text {
    font-size: 14px;
    color: #888;
    margin-top: 12px;
  }

  .empty-area {
    flex-direction: column;
    align-items: center;
    padding: 80px 20px;
  }

  .empty-icon {
    font-size: 48px;
  }

  .empty-text {
    font-size: 16px;
    color: #888;
    margin-top: 12px;
  }

  .empty-hint {
    font-size: 13px;
    color: #555;
    margin-top: 6px;
  }

  .gallery-list {
    flex: 1;
  }
</style>
